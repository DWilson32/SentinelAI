DATABASE_URL=sqlite:///./sentinel.db
# Production: Postgres with the pgvector extension (Neon), e.g.
# postgresql://user:pass@host/dbname?sslmode=require
# Semantic search needs pgvector; on SQLite the chat falls back to keyword retrieval.

# Comma-separated or JSON list, e.g. https://your-app.vercel.app
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
GNEWS_API_KEY=
NEWS_API_KEY=

# ReliefWeb only serves approved app names. Request one at
# https://apidoc.reliefweb.int/parameters#appname. Leave blank and the feed
# is skipped and shown as disabled instead of failing with 403 on every sync.
RELIEFWEB_APPNAME=

# Shared secret required by the ingest and reindex endpoints (X-API-Key header).
# Leave blank and those endpoints return 503 instead of being publicly writable.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SENTINEL_ADMIN_KEY=
RAG_CHUNK_CHARS=900
RAG_CHUNK_OVERLAP_CHARS=150

# Vector RAG uses pgvector in the main database; there is no separate vector store.
# Minimum cosine similarity for a chunk to be cited (calibrated on live data).
RAG_MIN_SIMILARITY=0.60
# Embedding model files are prefetched here at build time.
EMBEDDING_CACHE_DIR=./.model_cache

# Local embeddings via FastEmbed (default). Optional OpenAI for embeddings + answers.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384
USE_OPENAI_EMBEDDINGS=false
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
RAG_TOP_K=4
INDEX_INGESTED_SOURCES=false

# Language model for the agents and chat answers: any OpenAI-compatible endpoint.
# Defaults to Groq's free plan (no credit card): the open-weight openai/gpt-oss-120b,
# 1,000 requests and 200,000 tokens a day. Get a key at console.groq.com.
# The app stops at LLM_DAILY_TOKEN_BUDGET tokens a day and uses templates after that.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_DAILY_TOKEN_BUDGET=150000
# Without any key, the agents and chat use rule-based templates.
